# Files to be ignored for versioning with git
# Shell wildcards are possible
# / is the project root
# add * to commit directories with .gitkeep
.idea
/nbproject

# AI context information (not for version control)
ki_infos/

# PHPUnit cache
.phpunit.result.cache

# Don't ignore .gitkeep and .htaccess files
# these are used to commit empty directories
!.gitkeep
!.htaccess