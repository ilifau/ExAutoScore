# Files to be ignored for versioning with git
# Shell wildcards are possible
# / is the project root
# add * to commit directories with .gitkeep
.idea
/nbproject

# AI context information (not for version control)
ki_infos/

# PHPUnit cache
.phpunit.result.cache

# PHPUnit wird nur lokal zum Testen nachgezogen (composer require --dev phpunit/phpunit).
# Das Plugin selbst hat bewusst KEINE composer-Verwaltung: es wird als Verzeichnis
# ausgeliefert, und eine composer.json hier wuerde beim Deployen nur verwirren.
vendor/
composer.json
composer.lock

# Don't ignore .gitkeep and .htaccess files
# these are used to commit empty directories
!.gitkeep
!.htaccess