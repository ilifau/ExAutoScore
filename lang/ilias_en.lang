type_autoscore_team#:#Programming Assignment (Team)
service_assignment_url#:#Registration URL
service_assignment_url_info#:#URL for registering a programming assignment. The Dockerfile, support files and sample solution for testing are sent to this URL. The service builds the container image from this and executes the sample solution as a test.
service_task_url#:#Submission URL
service_task_url_info#:#URL for submitting a participant solution. The submitted files are sent to this URL for grading.
service_api_key#:#API Key
service_api_key_info#:#The API key authenticates the service calls.
service_timeout#:#Timeout
service_timeout_info#:#Maximum time in seconds to wait for a response from the service
creator_roles#:#Creator Roles
creator_roles_info#:#Only members of these roles can create new programming assignments or edit their grading settings and thus trigger the creation of a container on the grading server.
